import customtkinter

class APP(customtkinter.CTk):
    def __init__(self):
        super().__init__()
        
        self.title("DEMO APP")
        self.geometry("500x500")
        
        self.grid_columnconfigure((0,1), weight=1)
        
        self.button = customtkinter.CTkButton(self, text="ON/OFF", command=self.call_button)
        self.button.grid(row=0, column=0, padx=50, pady=50, sticky="ew", columnspan=5)
        
        self.checkbox1 = customtkinter.CTkCheckBox(self, text="Checkbox 1")
        self.checkbox1.grid(row=1, column=0, padx=25, pady=(0,25), sticky="w")
        self.checkbox2 = customtkinter.CTkCheckBox(self, text="Checkbox 2")
        self.checkbox2.grid(row=1, column=2, padx=25, pady=(0,25), sticky="e")
        
    def call_button(self):
        print("ON/OFF Hua")

app = APP()
app.mainloop()
      
